# Copy to .env (never commit .env). All keys are optional.
# Keys set here are server-wide "administrator" keys; users can also enter their own
# keys in the app's Settings dialog, which are kept only in their browser session.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# Default model for the CLI (main.py), as a LiteLLM model string
TRUEALIGN_MODEL=gemini/gemini-3.8-flash
